# Copy to .env and fill in real values. Never commit .env.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
# Password or programmatic access token (PAT)
SNOWFLAKE_PASSWORD=your_password_or_pat
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=RISK_MONITOR
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_ROLE=your_role
# Set to true ONLY to disable TLS certificate validation (e.g. a broken local
# cert chain). Leave false in any real environment.
SNOWFLAKE_INSECURE_MODE=false

# --- AWS S3 (raw snapshot storage) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# --- Data collection (fetch_to_s3.py only) ---
TICKER=AAPL

# --- LLM (agents) ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Legacy fallback for OPENAI_MODEL
# AGENT_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5
AGENT_MAX_RETRIES=3

# --- Slack alerts ---
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#options-alerts
